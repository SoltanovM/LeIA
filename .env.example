# .env.example — copie para `.env` e ajuste. (`cp .env.example .env`)

# Porta do app (host e container).
LEIA_PORT=8086

# Login (usuário default). Senha vazia = login desabilitado; preencha no .env local.
AUTH_USER=matt
AUTH_PASSWORD=

# Conjunto de adapters: mock (offline, sem AWS/Postgres) | aws (Bedrock + S3 + Postgres/pgvector).
BACKEND=mock

# --- AWS / Bedrock (usado só com BACKEND=aws) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
S3_BUCKET=leia-documents

# Postgres (metadados + pgvector). No compose o host é `postgres`; rodando local, `localhost`.
DATABASE_URL=postgresql://leia:leia@localhost:5432/leia

# Servidor MCP (o agente do chat conecta aqui). No compose é sobrescrito p/ leia-mcp:8087.
MCP_URL=http://localhost:8087/mcp

# Credenciais AWS (deixe em branco se usar `aws configure` / AWS_PROFILE no host).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# FRP (túnel) — usado só no deploy (make up). CONFIDENCIAL; nunca versione o .env.
# Consumidos pelo frpc.toml via {{ .Envs.X }}. FRP_TOKEN = o MESMO do frps no relay.
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_REMOTE_PORT=8086
FRP_TOKEN=

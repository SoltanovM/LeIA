# .env.example - copie para `.env` e ajuste. (`cp .env.example .env`)

# Porta do app (host e container).
LEIA_PORT=8086

# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Credenciais AWS (deixe em branco se usar `aws configure` / AWS_PROFILE no host).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
